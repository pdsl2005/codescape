{
  "name": "codescape",
  "displayName": "codescape",
  "description": "Welcome to Codescapes, where you build cities from your code.",
  "version": "0.0.1",
  "icon": "media/images/isoCube.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codescape.createPanel",
        "title": "Create Panel"
      },
      {
        "command": "codescape.createSidePanel",
        "title": "Codescape: Open in Side Panel"
      },
      {
        "command": "codescape.createBottomPanel",
        "title": "Codescape: Open in Bottom Panel"
      },
      {
        "command": "codescape.scan",
        "title": "Codescape Scan"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "codescapePanel",
          "title": "Codescape",
          "icon": "media/images/isoCube.png"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "codescape.Cityview",
          "name": "Codescape City"
        }
      ],
      "codescapePanel": [
        {
          "type": "webview",
          "id": "codescape.BottomView",
          "name": "Codescape"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && npm run build:webview",
    "reset-city": "node out/scripts/reset-city.js",
    "build:webview": "node esbuild.webview.mjs",
    "watch": "npm run build:webview && tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/three": "^0.183.1",
    "@types/vscode": "^1.74.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  },
  "dependencies": {
    "minimatch": "^10.1.2",
    "three": "^0.183.2",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-python": "^0.25.0",
    "web-tree-sitter": "^0.26.5"
  }
}
