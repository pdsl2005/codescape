{
  "name": "codescape",
  "displayName": "codescape",
  "description": "Welcome to Codescapes, where you build cities from your code.",
  "version": "0.0.1",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Codescape",
      "properties": {
        "codescape.supabaseUrl": {
          "type": "string",
          "default": "",
          "description": "Supabase project URL (e.g. https://xyzcompany.supabase.co). Used to call Edge Functions for website account linking."
        },
        "codescape.functionsAnonKey": {
          "type": "string",
          "default": "",
          "description": "Supabase anon (public) key. Passed as apikey when invoking Edge Functions from the extension."
        },
        "codescape.websiteUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "Codescape web app URL. Opened when you need to sign in on the website before linking from VS Code."
        }
      }
    },
    "commands": [
      {
        "command": "codescape.linkWebsiteAccount",
        "title": "Codescape: Link website account (GitHub)"
      },
      {
        "command": "codescape.unlinkWebsiteAccount",
        "title": "Codescape: Unlink website account"
      },
      {
        "command": "codescape.showLinkedAccount",
        "title": "Codescape: Show linked website account"
      },
      {
        "command": "codescape.createPanel",
        "title": "Create Panel"
      },
      {
        "command": "codescape.createSidePanel",
        "title": "Codescape: Open in Side Panel"
      },
      {
        "command": "codescape.createBottomPanel",
        "title": "Codescape: Open in Bottom Panel"
      },
      {
        "command": "codescape.scan",
        "title": "Codescape Scan"
      }
    ],
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "codescape.Cityview",
          "name": "Codescape City"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.74.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  },
  "dependencies": {
    "minimatch": "^10.1.2",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-python": "^0.25.0",
    "web-tree-sitter": "^0.26.5"
  }
}